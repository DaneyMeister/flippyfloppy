VITE_API_URL=http://localhost:4000

# --- Server-less build only (GitHub Pages) ---
# Set VITE_DEMO_MODE=true to run the client with its built-in API and data,
# no server needed. The GitHub Pages workflow sets this; leave it off normally.
# VITE_DEMO_MODE=true
#
# The one account allowed to log in to that build. Store only a SHA-256 of the
# password; make it in client/ with:
#   node -e "console.log(require('crypto').createHash('sha256').update('yourPassword').digest('hex'))"
# The hash ends up in the public site, so use a password you don't use anywhere else.
# VITE_DEMO_USERNAME=admin
# VITE_DEMO_PASSWORD_SHA256=paste-the-hash-here
