# Settings for `docker compose up` (compose.yml). Copy to .env and fill in.
# For running without Docker, use server/.env.example and client/.env.example instead.

# Database created inside the db container
POSTGRES_USER=flippyfloppy
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=flippyfloppy

# Auth
JWT_SECRET=change-this-to-a-long-random-string
AUTH_USERNAME=admin
# bcrypt hash of your password. Generate it in server/ with:
#   node -e "console.log(require('bcryptjs').hashSync('yourPassword', 10))"
# Keep the SINGLE quotes: the hash contains $ signs that Compose would
# otherwise try to expand as variables.
AUTH_PASSWORD_HASH='paste-the-hash-here'

# Where the client runs (for CORS)
CLIENT_ORIGIN=http://localhost:5173

# Load the invented sample data on start (true/false)
SEED_ON_START=true
