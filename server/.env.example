PORT=4000

# PostgreSQL connection
DATABASE_URL=postgres://flippyfloppy:flippyfloppy@localhost:5432/flippyfloppy
# Set to true for a hosted database that requires SSL (Render, Supabase, Neon).
# Leave empty for a local database
DATABASE_SSL=

# Auth
JWT_SECRET=change-this-to-a-long-random-string
AUTH_USERNAME=admin
# bcrypt hash of your chosen password -- generate with:
#   node -e "console.log(require('bcryptjs').hashSync('yourPassword', 10))"
AUTH_PASSWORD_HASH=

# Allowed origin for the Vite dev client
CLIENT_ORIGIN=http://localhost:5173

# Number of proxies in front of the API. Leave empty locally; set to 1 when
# hosted behind one proxy (e.g. Render), so the login rate limit sees real IPs
TRUST_PROXY=
